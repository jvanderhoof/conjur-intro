#!/usr/bin/env bash

# Provisions a Conjur environment from a declarative spec, then checks that what
# came up is what was asked for.
#
# The ordering knowledge lives here rather than in a skill's prose because it is
# deterministic and testable: see test/env.bats, and
# docs/declarative-environments.md for the design and its known debt.

set -euo pipefail

# A spec path is resolved against wherever the user ran this from, not the repo
# root we are about to move to.
CALLER_PWD="$PWD"

# Always work from repo root directory. BASH_SOURCE rather than $0 so that
# test/env.bats can source this file to reach the verification helpers.
cd "$(dirname "${BASH_SOURCE[0]}")/.."

source ./bin/utils.sh

# Make sure .env envvars are available
dotenv > /dev/null 2>&1 || true

CONJUR_MASTER_PORT="${CONJUR_MASTER_PORT:-443}"

# Follower 1's own published port, read the same way docker-compose.yml reads it;
# bin/utils.sh's _follower_port derives every follower's from it. Verification
# probes each follower on its own port rather than through the load balancer so
# that follower health and replication are separate findings from the follower
# tier's proxy -- an haproxy that is down then shows up as the secret not reading
# back, and not as mismatched rows that all point at each other.
CONJUR_FOLLOWER_PORT="${CONJUR_FOLLOWER_PORT:-450}"

# The follower load balancer as the host reaches it, and its stats page, which is
# where the load balancer says which followers it has been sending requests to.
# Both fixed in docker-compose.yml.
FOLLOWER_LB_HEALTH_URL='https://localhost:449/health'
FOLLOWER_LB_STATS_URL='http://localhost:7001/;csv'

# What clients reach the follower tier through, and so how the retrieval check
# reads. The follower load balancer's name on the compose network, not localhost,
# because bin/api runs inside a container. Passed as --leader-url because that is
# the URL bin/api fetches secrets from; it still authenticates through its own
# --follower-url default, which is the same load balancer over http, so both halves
# of the read go through the follower tier. It does not check the certificate --
# bin/api's curls are all --insecure -- so a broken follower certificate is not
# something this row can see.
FOLLOWER_URL='https://conjur-follower.mycompany.local'

# Holds the YAML parser and the JSON Schema validator so that neither is a host
# dependency. Bump the tag when artifacts/env-validator changes.
VALIDATOR_IMAGE='conjur-intro/env-validator:5'
SCHEMA='environments/schema.json'

# The appliance image docker-compose.yml starts. Preflight resolves the
# requested tag against this before anything is provisioned.
APPLIANCE_IMAGE='registry.tld/conjur-appliance'

# How long the registry gets to answer. Off VPN registry.tld does not answer at
# all, and an unbounded TCP timeout is the opposite of failing fast.
REGISTRY_TIMEOUT_SECONDS=30

# One of the variables `bin/api --load-sample-policy-and-values` sets. Verifying
# that this reads back is the difference between "the appliance is up" and "the
# appliance is usable for a repro".
SAMPLE_SECRET='staging/my-app-1/postgres-database/password'
SAMPLE_SECRET_VALUE='secret-p@ssword-staging-my-app-1'

# The only auto-failover cluster bin/dap enrols. Named here because verification
# checks for it and the spec has no field to override it: `auto_failover: true`
# means this cluster.
CLUSTER_NAME='production'

function _print_help {
  cat << EOF

Provisions a Conjur environment from a declarative spec.

Usage: bin/env [options] <spec>

    --plan          Print the ordered command sequence and the checks that would
                      follow it, then exit without provisioning anything.

    --recreate      Tear the existing environment down and build the spec from
                      clean. This destroys every volume the environment holds:
                      its data, its replication seeds, its master key and its
                      audit history. The flag is the confirmation -- there is no
                      second prompt -- so read what it prints before you use it.

    -h, --help      Shows this help message.

The spec is a YAML file validated against $SCHEMA; an unknown or
misspelled key, or a topology bin/env cannot build, is a hard error naming the
offending field. Start from environments/examples/single-node.yml,
environments/examples/highly-available.yml for a leader with standbys,
environments/examples/leader-and-follower.yml for a leader and a follower,
environments/examples/multiple-followers.yml for a load-balanced follower tier, or
environments/examples/hardened.yml for custom certificates and master key
encryption across all three tiers.

Nothing is reconciled. If an environment already exists in this working copy,
bin/env refuses rather than half-configuring it; rebuild with --recreate, or
tear it down with bin/dap --stop. Before provisioning, a preflight checks that
the requested appliance version resolves and that the host ports are free, so an
environment that cannot come up fails in seconds rather than minutes.

Specs written directly into environments/ are gitignored. This repo is mirrored
to the public conjurdemos GitHub org, so customer hostnames and admin passwords
must never end up in a tracked file.

Up to 4 standbys can be provisioned, optionally enrolled in an auto-failover
cluster -- which needs at least 2 of them to hold a quorum. Up to 3 followers can
be provisioned alongside them, behind a load balancer generated with a backend per
follower; asking for followers also configures their proxy trust, so there is no
manual follow-up step. A fourth follower would need a new compose service, so the schema
rejects it rather than letting bin/env quietly build something smaller.

The leader can be hardened with master key encryption, custom certificates and
generated DH parameters, each an independent boolean that defaults to off. All
three are applied to the leader before anything is seeded from it, and each is
verified off the leader itself -- its key files, the chain it presents, the DH
parameters nginx serves -- rather than off the bin/dap step having run. Custom
certificates allow at most 2 standbys, because the generated certificate names
no more.

Podman is not supported: use bin/podman-dap directly.

Usage and troubleshooting: docs/environments.md
Design and decisions:      docs/declarative-environments.md

EOF
  exit
}

#
## Spec handling
#

function _spec_path {
  local given="$1"

  if [[ "$given" != /* ]] && [[ -f "$CALLER_PWD/$given" ]]; then
    echo "$CALLER_PWD/$given"
  else
    echo "$given"
  fi
}

# Always rebuilt, never skipped when the tag already exists: a cached build takes
# a fraction of a second, whereas a stale validator would keep applying an old
# copy of the schema logic and say nothing.
function _build_validator {
  docker build --quiet --tag "$VALIDATOR_IMAGE" artifacts/env-validator > /dev/null
}

# Converts the spec to JSON and validates it in a single pass, echoing the
# resolved spec -- the spec with every schema default filled in.
function _resolve_spec {
  local spec_file="$1"

  if [[ ! -f "$spec_file" ]]; then
    echo "bin/env: no such spec: $spec_file" >&2
    return 1
  fi

  _build_validator

  docker run --rm --interactive \
    --volume "$PWD/$SCHEMA:/schema.json:ro" \
    "$VALIDATOR_IMAGE" < "$spec_file"
}

# Reads the resolved spec into one variable per field. Done once, so that the
# rest of the script reads plainly and does not spawn a jq per field.
function _read_spec {
  local resolved="$1"

  IFS=$'\t' read -r SPEC_VERSION SPEC_STANDBYS SPEC_AUTO_FAILOVER \
    SPEC_MASTER_KEY_ENCRYPTION SPEC_CUSTOM_CERTIFICATES SPEC_GENERATE_DH \
    SPEC_FOLLOWERS SPEC_SAMPLE_DATA \
    <<< "$(jq --raw-output \
      '[.version, .leader.standbys, .leader.auto_failover,
        .leader.master_key_encryption, .leader.custom_certificates, .leader.generate_dh,
        .followers, .sample_data] | @tsv' \
      <<< "$resolved")"
}

#
## Runtime
#
# Which container runtime this is does not depend on the spec, so this is settled
# before the spec is even read, and outside preflight -- preflight is about the
# environment being buildable, this is about bin/env being the right tool at all.

# Whatever can be learned cheaply about the runtime the docker CLI talks to.
# Separate from the check so the tests can stand in a podman host's answers, and
# deliberately string-based: there is no single authoritative field, and any of
# these naming podman is enough to stop.
function _runtime_identity {
  echo "${DOCKER_HOST:-}"

  # Empty, not an error, when no daemon is reachable -- the refusal below must
  # not depend on the thing it is refusing being up.
  docker version --format '{{.Server.Platform.Name}}' 2> /dev/null || true
  docker --version 2> /dev/null || true
}

# Runs for every invocation, --plan included: this is a fact about the machine
# rather than about the spec, and a plan that could never run is worse than no
# plan at all.
function _refuse_podman {
  if ! grep --quiet --ignore-case podman <<< "$(_runtime_identity)"; then
    return 0
  fi

  echo 'bin/env: podman is not supported. Use bin/podman-dap directly.' >&2
  echo 'bin/env:   bin/podman-dap is a drifted fork of bin/dap -- different host ports, no' >&2
  echo 'bin/env:   master key encryption, a hardcoded standby count -- so a spec bin/env' >&2
  echo 'bin/env:   accepts does not describe what it would build. A declarative layer over' >&2
  echo 'bin/env:   it would misrepresent that, so there is deliberately not one.' >&2
  exit 1
}

#
## Preflight
#
# Read-only checks that run before the first provisioning command, so that an
# environment which cannot possibly come up fails in seconds rather than six
# minutes into `evoke configure master`.
#
# Nothing here has a side effect. With --recreate the teardown is a provisioning
# command like any other, which is what keeps a failed check from leaving an
# operator with a destroyed environment and no replacement.

# Runs a command with a ceiling on how long it may take. `timeout` itself would
# be a host dependency: macOS does not ship it.
function _with_timeout {
  local seconds="$1"
  shift

  local pid
  local waited=0

  "$@" &
  pid=$!

  while kill -0 "$pid" 2> /dev/null; do
    if (( waited >= seconds )); then
      kill "$pid" 2> /dev/null || true
      wait "$pid" 2> /dev/null || true
      # What timeout(1) reports, for the same reason.
      return 124
    fi

    sleep 1
    waited=$((waited + 1))
  done

  wait "$pid"
}

### An environment that already exists

# Container ids belonging to this compose project, whatever state they are in.
function _project_container_ids {
  docker compose ps --all --quiet 2> /dev/null || true
}

# The containers this working copy already has, as `name (state)` lines. No
# output means there is no environment here.
function _existing_environment {
  local ids
  local names

  ids="$(_project_container_ids)"
  if [[ -z "$ids" ]]; then
    return 0
  fi

  # Unquoted so each id is its own argument. Names are more use than ids in the
  # refusal, but the ids are what we are certain of, so they are the fallback --
  # which `|| true` is what makes reachable, since otherwise `set -o pipefail`
  # turns an inspect of a container that has since gone into a silent exit here.
  # shellcheck disable=SC2086
  names="$(docker inspect --format '{{.Name}} ({{.State.Status}})' $ids 2> /dev/null | sed 's|^/||' || true)"

  printf '%s\n' "${names:-$ids}"
}

function _refuse_existing_environment {
  local existing="$1"

  echo 'bin/env: an environment already exists in this working copy:' >&2
  printf '%s\n' "$existing" | sed 's/^/  /' >&2
  echo 'bin/env: nothing is reconciled, so this is refused rather than half-configured.' >&2
  echo 'bin/env:   Rebuild it from clean with --recreate, which destroys its data, its' >&2
  echo 'bin/env:   replication seeds, its master key and its audit history.' >&2
  echo 'bin/env:   Or tear it down yourself with bin/dap --stop.' >&2
  exit 1
}

### Topology

# docker-compose.yml names the appliance nodes conjur-master-1 through
# conjur-master-5. Here rather than inline so that the one place a node number
# becomes a hostname is the one place to change if the naming ever does.
function _node_host {
  echo "conjur-master-$1.mycompany.local"
}

# The standbys the spec asked for, by node number. The leader is node 1, so
# standbys run from 2 to one past the count -- arithmetic that every loop over the
# standbys would otherwise repeat, and that is off by one in either direction if it
# is got wrong.
function _standby_numbers {
  local number

  for (( number = 2; number <= SPEC_STANDBYS + 1; number++ )); do
    echo "$number"
  done
}

# The followers the spec asked for, by number. Followers have a tier of their own,
# so they start at 1.
function _follower_numbers {
  local number

  for (( number = 1; number <= SPEC_FOLLOWERS; number++ )); do
    echo "$number"
  done
}

### Host ports

# The host ports the planned topology binds. docker compose fails on a port it
# cannot bind, and it fails only after pulling the appliance image, so this is
# worth knowing up front.
#
# Grouped by tier rather than sorted, so the list reads as the leader's ports and
# then the follower's. Every number here is docker-compose.yml's, and has to stay
# in step with it.
function _required_ports {
  local number

  echo "$CONJUR_MASTER_PORT"  # the leader load balancer
  echo 444                    # the leader appliance, published directly

  # docker-compose.yml publishes each conjur-master node on 443 plus its number,
  # so the leader is on 444 and the standbys follow it.
  for number in $(_standby_numbers); do
    echo $((443 + number))
  done

  echo 7000                   # the leader load balancer's stats page

  if (( SPEC_FOLLOWERS > 0 )); then
    # Three for the follower load balancer and one for each follower. Plain 80 is in
    # there, which is the one most likely to be in use already on a developer's
    # machine, and the reason this is worth checking rather than discovering when
    # compose fails.
    echo 80                       # the follower load balancer, unencrypted
    echo 449                      # the follower load balancer

    # Each follower published directly, on bin/utils.sh's _follower_port.
    for number in $(_follower_numbers); do
      _follower_port "$number"
    done

    echo 7001                     # the follower load balancer's stats page
  fi
}

function _required_ports_list {
  local joined=''
  local port

  while IFS= read -r port; do
    joined+="${joined:+, }$port"
  done < <(_required_ports)

  echo "$joined"
}

# A process listening on a host port, named if the host has a tool that can say
# which. Without one we can still tell that something answers, which is the part
# that decides whether provisioning would fail.
function _listener_on {
  local port="$1"
  local process

  # The (LISTEN) column is checked as well as asked for: busybox's lsof ignores
  # these options and lists every open file it can see, and taking its first
  # line would name some unrelated process as the holder of a free port.
  #
  # `|| true` because a host with no lsof at all exits 127, and under `set -o
  # pipefail` that would fail the assignment and take bin/env down here --
  # silently, stderr being discarded -- rather than falling through below.
  process="$(lsof -nP -iTCP:"$port" -sTCP:LISTEN 2> /dev/null \
    | awk '$NF == "(LISTEN)" { print $1 " (pid " $2 ")" ; exit }' || true)"

  if [[ -n "$process" ]]; then
    echo "$process"
    return 0
  fi

  # No lsof, or one that could not answer. Something accepting connections is
  # still enough to know the port cannot be bound.
  if (exec 3<> "/dev/tcp/127.0.0.1/$port") 2> /dev/null; then
    echo 'an unidentified process'
  fi
}

# What holds a host port, as a phrase to print, or nothing when it is free.
function _port_holder {
  local port="$1"
  local ours
  local id
  local name
  local mine=false

  ours="$(_project_container_ids)"

  # A container publishing the port is both the likeliest holder and the most
  # useful thing to name.
  for id in $(docker ps --filter "publish=$port" --quiet 2> /dev/null || true); do
    # One of ours is not a conflict: the environment it belongs to is torn down
    # before the new one needs the port. Returning early would instead report
    # docker's own proxy process, and refuse to rebuild what it just described.
    if [[ -n "$ours" ]] && grep --quiet --fixed-strings "$id" <<< "$ours"; then
      mine=true
      continue
    fi

    # `|| true` for the same reason as above: the id is the fallback, so a failed
    # inspect has to fall through to it rather than end the run.
    name="$(docker inspect --format '{{.Name}}' "$id" 2> /dev/null | sed 's|^/||' || true)"
    echo "container ${name:-$id}"
    return 0
  done

  if [[ "$mine" == true ]]; then
    return 0
  fi

  _listener_on "$port"
}

### The appliance version

function _image_in_local_cache {
  docker image inspect "$APPLIANCE_IMAGE:$1" > /dev/null 2>&1
}

function _manifest_in_registry {
  # --insecure because registry.tld's certificate is issued for another name.
  # The daemon is configured to pull from it regardless, but `docker manifest`
  # reaches the registry from the CLI and does not read that configuration, so
  # without this every tag looks unresolvable.
  _with_timeout "$REGISTRY_TIMEOUT_SECONDS" \
    docker manifest inspect --insecure "$APPLIANCE_IMAGE:$1"
}

### The checks themselves, in the order they run
#
# Cheapest first, and the existing-environment check before the port one: a live
# environment holds the ports it needs, and being told about port 443 when the
# real answer is "you already have one of these" is a worse message.

function _existing_environment_description {
  if [[ "$RECREATE" == true ]]; then
    echo 'any environment already here is torn down rather than reconciled (--recreate)'
  else
    echo 'no environment already exists in this working copy'
  fi
}

function _ports_description {
  echo "host ports $(_required_ports_list) are free"
}

function _version_description {
  echo "appliance image $APPLIANCE_IMAGE:$SPEC_VERSION resolves"
}

function _preflight_existing_environment {
  local existing

  existing="$(_existing_environment)"

  if [[ -n "$existing" ]] && [[ "$RECREATE" != true ]]; then
    _refuse_existing_environment "$existing"
  fi

  echo "  ok  $(_existing_environment_description)"
}

function _refuse_ports {
  local conflicts="$1"

  echo 'bin/env: a host port this environment needs is already in use:' >&2
  printf '%s' "$conflicts" >&2
  echo 'bin/env:   CONJUR_MASTER_PORT moves the leader load balancer off 443, and' >&2
  echo 'bin/env:   CONJUR_FOLLOWER_PORT moves the first follower off 450. The other' >&2
  echo 'bin/env:   ports -- 444 for the leader, then 445 up, one per standby, 7000,' >&2
  echo 'bin/env:   452 and 453 for the second and third followers, and 80, 449 and' >&2
  echo 'bin/env:   7001 for the follower load balancer -- are fixed in' >&2
  echo 'bin/env:   docker-compose.yml, so those have to be freed.' >&2
  exit 1
}

function _preflight_ports {
  local port
  local holder
  local conflicts=''

  while IFS= read -r port; do
    holder="$(_port_holder "$port")"

    if [[ -n "$holder" ]]; then
      conflicts+="  port $port is held by $holder"$'\n'
    fi
  done < <(_required_ports)

  if [[ -n "$conflicts" ]]; then
    _refuse_ports "$conflicts"
  fi

  echo "  ok  $(_ports_description)"
}

# $1 is the exit status the lookup failed with, $2 whatever it said.
function _refuse_version {
  local status="$1"
  local answer="$2"

  echo "bin/env: appliance version $SPEC_VERSION does not resolve as $APPLIANCE_IMAGE:$SPEC_VERSION." >&2

  if (( status == 124 )); then
    echo "bin/env:   the registry did not answer within ${REGISTRY_TIMEOUT_SECONDS}s. registry.tld is" >&2
    echo 'bin/env:   internal, so this is usually the VPN.' >&2
  elif [[ "$answer" == *'no such manifest'* ]] || [[ "$answer" == *'manifest unknown'* ]]; then
    echo 'bin/env:   the registry answered, and has no such tag. Check the version in the spec.' >&2
  else
    printf '%s\n' "$answer" | sed 's/^/bin\/env:   /' >&2
    echo 'bin/env:   the registry could not be reached. registry.tld is internal, so this is' >&2
    echo 'bin/env:   usually the VPN.' >&2
  fi

  echo 'bin/env:   A tag already pulled needs neither: docker images | grep conjur-appliance' >&2
  exit 1
}

function _preflight_version {
  local answer
  local status=0

  # bin/dap does not force a pull, so a tag already in the local cache
  # provisions without the registry -- and so without the VPN.
  if _image_in_local_cache "$SPEC_VERSION"; then
    echo "  ok  $(_version_description) (local cache)"
    return 0
  fi

  # stderr into the capture and stdout away: the manifest itself is of no
  # interest, and the registry's own words are the useful part of a failure.
  answer="$(_manifest_in_registry "$SPEC_VERSION" 2>&1 > /dev/null)" || status=$?

  if (( status == 0 )); then
    echo "  ok  $(_version_description) (registry)"
    return 0
  fi

  _refuse_version "$status" "$answer"
}

function _preflight {
  echo 'Preflight'
  echo

  _preflight_existing_environment
  _preflight_ports
  _preflight_version
}

function _preflight_descriptions {
  _existing_environment_description
  _ports_description
  _version_description
}

#
## Planning
#

# The ordered sequence of underlying commands, one per line. This is the whole
# of the spec-to-sequence translation, which is why --plan is both what the
# tests assert and what the skill shows before provisioning.
function _provision_commands {
  local -a leader

  # A clean rebuild rather than a reconcile, and a provisioning command rather
  # than part of preflight, so that every check has passed before any data goes.
  if [[ "$RECREATE" == true ]]; then
    echo 'bin/dap --stop'
  fi

  # bin/dap defaults to two standbys, and its default reaches further than the
  # standby commands: `evoke configure master` takes the standby hostnames as
  # certificate altnames, so the leader has to be provisioned with the count the
  # spec asked for or it issues a certificate the standbys cannot be reached on.
  #
  # The count is passed only when the spec asks for standbys. With none, bin/dap's
  # own default produces the leader certificate that single-node environments
  # already verify against, and `--standby-count 0` would instead hand
  # `evoke configure master` a trailing comma in its altname list.
  leader=(bin/dap --version "$SPEC_VERSION")
  if (( SPEC_STANDBYS > 0 )); then
    leader+=(--standby-count "$SPEC_STANDBYS")
  fi

  # A modifier of this command rather than a step of its own: bin/dap copies the
  # pre-generated files/dhparam.pem to where `evoke configure master` looks for DH
  # parameters, and --generate-dh copies it somewhere else instead, so configure
  # finds none and has the appliance generate its own. Configure is the only time
  # that choice is made.
  if [[ "$SPEC_GENERATE_DH" == true ]]; then
    leader+=(--generate-dh)
  fi
  echo "${leader[*]} --provision-master"

  # bin/dap returns as soon as `evoke configure master` does, which is before
  # the appliance serves traffic. Everything after this point needs a healthy
  # leader.
  echo 'bin/dap --wait-for-master'

  # The leader is hardened before anything is seeded from it, because a seed
  # carries the leader's certificates, keys and DH parameters to whatever it
  # seeds: a standby or follower seeded first would come up with the self-signed
  # certificates, plaintext keys or bootstrap parameters, and stay that way.

  # `evoke ca import` replaces certificates the leader already has, so it needs a
  # configured leader. It also imports the follower's certificate into the leader,
  # which is how a follower seeded later gets it. No --version: it runs the
  # certificate generator, which pins its own, and then only execs into the
  # leader.
  if [[ "$SPEC_CUSTOM_CERTIFICATES" == true ]]; then
    echo 'bin/dap --import-custom-certificates'
  fi

  # After the certificates, so the keys they import are encrypted along with the
  # rest: imported afterwards, a key lands on disk in plaintext beside ones that
  # are not, and the leader still reports itself healthy. Before any seed, because
  # bin/dap configures a standby or follower with the master key only if the
  # leader already has one. Unlocking the keys restarts nginx, postgres and conjur,
  # hence the second wait.
  if [[ "$SPEC_MASTER_KEY_ENCRYPTION" == true ]]; then
    echo 'bin/dap --enable-mke'
    echo 'bin/dap --wait-for-master'
  fi

  # Configure does not generate the DH parameters itself. It installs an RFC 3526
  # group tagged `BOOTSTRAP PARAMETERS` and starts the generation in the
  # background, at idle priority, swapping the result in when it finishes -- so a
  # leader that is healthy is not yet a leader with generated parameters, and a
  # standby seeded from it now would inherit the bootstrap group.
  if [[ "$SPEC_GENERATE_DH" == true ]]; then
    echo 'bin/dap --wait-for-dh-params'
  fi

  # Brings each standby up, seeds it from the leader, starts synchronous
  # replication, and swaps the leader load balancer onto its multi-node
  # configuration. bin/dap waits for the leader again at the end of it.
  #
  # --version again, and not for tidiness: bin/dap passes it to compose as
  # VERSION, and every conjur-master service resolves its image from that. A step
  # that brings a container up without it gets bin/dap's own default tag, so the
  # spec's version would reach the leader and 5.0-stable would reach the standbys.
  if (( SPEC_STANDBYS > 0 )); then
    echo "bin/dap --version $SPEC_VERSION --standby-count $SPEC_STANDBYS --provision-standbys"
  fi

  # Enrolment needs every node it is about to enrol to be up, so it follows the
  # standbys. It loads policy of its own -- the root policy and the cluster's --
  # which is why the sample data goes in after it rather than before: the
  # retrievability check then speaks for the finished cluster rather than for the
  # leader it started as.
  #
  # No --version here: enrolment only execs into containers that are already up,
  # and loads policy through the pinned CLI image, so it never resolves an
  # appliance tag. The count is unconditional because the schema will not accept
  # auto-failover without at least two standbys.
  if [[ "$SPEC_AUTO_FAILOVER" == true ]]; then
    echo "bin/dap --standby-count $SPEC_STANDBYS --enable-auto-failover"
  fi

  # The follower comes after enrolment and before the sample data, and both halves
  # of that matter.
  #
  # After enrolment because `evoke configure follower` installs the failover
  # rebaser, which is what repoints the follower at a newly promoted leader -- so
  # the cluster wants to exist by the time the follower is configured against it.
  #
  # Before the sample data because `evoke seed follower` snapshots the leader's
  # database. A follower seeded after the sample data serves that secret out of its
  # own snapshot whether or not replication ever started, so the retrieval check
  # would pass on a follower that is not replicating at all. Seeded first, the
  # sample secret can only reach the follower by replicating.
  #
  # --version for the same reason as the standbys: this brings the followers up,
  # and compose resolves their image from VERSION. --follower-count on both
  # commands, as --standby-count is on the standby ones: the first decides which
  # followers are started and how many backends the load balancer gets, the second
  # which followers are told to trust it.
  if (( SPEC_FOLLOWERS > 0 )); then
    echo "bin/dap --version $SPEC_VERSION --follower-count $SPEC_FOLLOWERS --provision-follower"

    # Tells the follower to trust the X-Forwarded-For its load balancer sets, so
    # that audit records and IP-restricted host identities see the real client
    # rather than the load balancer. Not a reachability step -- a follower serves
    # secrets without it -- but a correctness one, and the kind of difference that
    # decides whether an authorization repro behaves like the customer's. A separate
    # command in bin/dap, and so a separate command here, but not an optional one:
    # requesting a follower should not leave a manual step behind.
    #
    # No --version -- it only execs into the running followers.
    echo "bin/dap --follower-count $SPEC_FOLLOWERS --trust-follower-proxy"
  fi

  if [[ "$SPEC_SAMPLE_DATA" == true ]]; then
    echo 'bin/api --load-sample-policy-and-values'
  fi
}

function _check_descriptions {
  local number

  echo 'leader /health reports ok'
  echo 'leader /info reports its configuration'
  echo "leader image tag is $SPEC_VERSION"

  # Checked either way, like auto-failover: a hardened leader the spec did not ask
  # for is as much a different environment as the reverse.
  if [[ "$SPEC_MASTER_KEY_ENCRYPTION" == true ]]; then
    echo 'leader server keys are encrypted with a master key'
  else
    echo 'leader server keys are not encrypted with a master key'
  fi

  if [[ "$SPEC_CUSTOM_CERTIFICATES" == true ]]; then
    echo 'leader presents a certificate issued by the custom CA'
  else
    echo 'leader presents a certificate issued by its own appliance CA'
  fi

  if [[ "$SPEC_GENERATE_DH" == true ]]; then
    echo 'leader DH parameters were generated by the leader'
  else
    echo 'leader DH parameters are the pre-generated files/dhparam.pem'
  fi

  echo "standbys running is $SPEC_STANDBYS"

  for number in $(_standby_numbers); do
    echo "standby $number is replicating from the leader"
  done

  echo "followers running is $SPEC_FOLLOWERS"

  # Asked of the follower itself rather than of the leader, so that a follower that
  # is up while the leader is not still reports its own state -- and so that a
  # leader that is fine cannot answer for a follower that is not.
  for number in $(_follower_numbers); do
    echo "follower $number /health reports ok"
    echo "follower $number is replicating from the leader"
  done

  if (( SPEC_FOLLOWERS > 0 )); then
    if [[ "$SPEC_SAMPLE_DATA" == true ]]; then
      echo "sample secret $SAMPLE_SECRET is retrievable through the follower load balancer"
    fi

    if (( SPEC_FOLLOWERS == 1 )); then
      echo 'follower load balancer routes to 1 follower'
    else
      echo "follower load balancer routes to $SPEC_FOLLOWERS followers"
    fi
  fi

  echo "auto-failover configured is $SPEC_AUTO_FAILOVER"

  # The leader is enrolled alongside its standbys, hence node 1 as well.
  if [[ "$SPEC_AUTO_FAILOVER" == true ]]; then
    echo "cluster name is $CLUSTER_NAME"

    for number in 1 $(_standby_numbers); do
      echo "$(_node_host "$number") is enrolled in the $CLUSTER_NAME cluster"
    done
  fi

  if [[ "$SPEC_SAMPLE_DATA" == true ]]; then
    echo "sample secret $SAMPLE_SECRET is retrievable"
  fi
}

function _numbered {
  local number=0
  local line

  while IFS= read -r line; do
    number=$((number + 1))
    printf '  %d. %s\n' "$number" "$line"
  done
}

# What --recreate costs, in words. `bin/dap --stop` in a command list does not
# say it, and this is the one thing bin/env does that cannot be undone.
function _print_destruction_notice {
  cat << EOF

--recreate destroys the environment already here before building the new one.
'bin/dap --stop' removes this compose project's volumes, and with them:

  - every policy and secret value loaded into the leader
  - the replication seeds held for any standby or follower
  - the master key
  - the audit database, and the audit history in it

Nothing is backed up first, and none of it can be recovered afterwards. Passing
--recreate is the confirmation; there is no second prompt.
EOF
}

function _print_plan {
  local spec_file="$1"

  echo "Plan for $spec_file"
  echo
  echo 'Resolved spec:'
  printf '  %-28s %s\n' 'version' "$SPEC_VERSION"
  printf '  %-28s %s\n' 'leader.standbys' "$SPEC_STANDBYS"
  printf '  %-28s %s\n' 'leader.auto_failover' "$SPEC_AUTO_FAILOVER"
  printf '  %-28s %s\n' 'leader.master_key_encryption' "$SPEC_MASTER_KEY_ENCRYPTION"
  printf '  %-28s %s\n' 'leader.custom_certificates' "$SPEC_CUSTOM_CERTIFICATES"
  printf '  %-28s %s\n' 'leader.generate_dh' "$SPEC_GENERATE_DH"
  printf '  %-28s %s\n' 'followers' "$SPEC_FOLLOWERS"
  printf '  %-28s %s\n' 'sample_data' "$SPEC_SAMPLE_DATA"
  echo
  echo 'Preflight:'
  _preflight_descriptions | _numbered
  echo
  echo 'Commands:'
  _provision_commands | _numbered
  echo
  echo 'Checks:'
  _check_descriptions | _numbered

  if [[ "$RECREATE" == true ]]; then
    _print_destruction_notice
  fi
}

#
## Provisioning
#

function _provision {
  local commands=()
  local command
  local argv

  # Read the whole sequence before running any of it. Running a command inside
  # the `while read` loop that produced it hands that command the loop's own
  # stdin, and anything which drains stdin then eats the steps that follow --
  # bin/dap does exactly this, via `docker compose exec -T`, so provisioning
  # stopped after the first command and still exited 0.
  while IFS= read -r command; do
    commands+=("$command")
  done < <(_provision_commands)

  for command in "${commands[@]}"; do
    echo
    echo "==> $command"

    # Split the planned command into an argument list and run it directly rather
    # than through eval. The version comes from a spec file, and no value out of
    # a spec should ever be able to turn into shell syntax.
    IFS=' ' read -r -a argv <<< "$command"
    "${argv[@]}"
  done
}

#
## Verification
#

# Reads one field out of an appliance API route on the given host port, reporting
# why it could not rather than failing. `unreachable` means nothing answered;
# `unparseable` means something did, but not the JSON we expected -- an HAProxy
# error page, say.
function _probe {
  local port="$1"
  local route="$2"
  local filter="$3"
  local body

  if ! body="$(curl --insecure --silent --max-time 10 "https://localhost:${port}/$route")"; then
    echo 'unreachable'
    return
  fi

  # --exit-status so that a null result counts as a failure rather than printing
  # the word "null" into the table.
  local value
  if value="$(jq --raw-output --exit-status "$filter" <<< "$body" 2> /dev/null)"; then
    echo "$value"
  else
    echo 'unparseable'
  fi
}

function _leader_probe {
  _probe "$CONJUR_MASTER_PORT" "$1" "$2"
}

# Follower $1's answer. The port is what makes this that follower's answer and not
# the leader's or another follower's, and it is the whole difference between them: a
# follower answers /health on the same route with the same shape, so a probe
# pointed at the wrong port reports on the wrong appliance without any sign that it
# has.
function _follower_probe {
  _probe "$(_follower_port "$1")" "$2" "$3"
}

# The top-level flag, shared by both appliances because it is the same claim about
# the same route. Note that it is not `services.ok`: the appliance rolls its service
# list up under an `ok` of its own, and reading that one would call an appliance
# healthy while its database or its cluster was not.
HEALTH_FILTER='if .ok == true then "ok" else "not ok" end'

function _leader_health {
  _leader_probe 'health' "$HEALTH_FILTER"
}

function _follower_health {
  _follower_probe "$1" 'health' "$HEALTH_FILTER"
}

# Followers replicate logically, over pglogical subscriptions, so they have no row
# in the leader's pg_stat_replication -- this is not the standby probe with a
# different host. It reads the follower's own view for two reasons: that view still
# answers when the leader is unreachable, and it distinguishes receiving changes
# from applying them. A follower streaming WAL it cannot apply reads as `streaming`
# from the leader's side and as `apply errors` from here.
#
# There is nothing to key the subscription on -- the name is an opaque
# `follower_<hex>_<hex>` with no hostname in it -- and no need to: a follower has
# exactly its own subscriptions.
#
# The type guard is not defensive. The leader answers this route with a *sentence*
# under `subscriptions` ("Subscriptions are only available on Conjur Followers."),
# so without it a probe pointed at the leader would take that string's truthiness
# for a healthy follower.
function _follower_replication_state {
  _follower_probe "$1" 'health' '
    if .database.logical_replication_status == null then null else
      .database.logical_replication_status as $status
      | ($status.subscriptions // []) as $subscriptions
      | if ($subscriptions | type) != "array" then "not a follower"
        elif ($subscriptions | length) == 0 then "not replicating"
        elif ($status.initial_replication_in_progress // false) then "initial sync"
        elif any($subscriptions[]; (.enabled // false) | not) then "disabled"
        elif any($subscriptions[]; (.apply_error_count // 0) > 0) then "apply errors"
        elif any($subscriptions[]; (.sync_error_count // 0) > 0) then "sync errors"
        else "replicating"
        end
    end'
}

# An enrolled auto-failover cluster reports its name under /info, which is how
# the rest of bin/dap detects one. `none` means /info answered with a
# configuration but no cluster, which is what a standalone leader looks like.
function _leader_cluster_name {
  _leader_probe 'info' 'if .configuration.conjur then .configuration.conjur.cluster_name // "none" else null end'
}

function _leader_info_state {
  case "$1" in
    unreachable | unparseable ) echo 'no' ;;
    * ) echo 'reported' ;;
  esac
}

function _auto_failover_state {
  case "$1" in
    "$CLUSTER_NAME" ) echo 'true' ;;
    none ) echo 'false' ;;
    unreachable | unparseable ) echo "$1" ;;
    # Enrolled, but not in the cluster bin/dap builds. The name is what the
    # operator has to reconcile, so print it rather than the word `unknown`.
    * ) echo "cluster $1" ;;
  esac
}

# The names etcd knows the auto-failover cluster's members by, one per line.
# `evoke cluster member list` prints etcd's own member list as JSON, and the
# machine names bin/dap enrols are the node hostnames.
#
# No output when there is no cluster, or when its etcd cannot answer. Both mean
# nothing is enrolled as far as verification is concerned, which is the truthful
# reading: a cluster that cannot report its members cannot fail over either.
#
# stdin is closed explicitly because `docker compose exec` forwards it, and a
# command that drains bin/env's stdin has already cost this script one silent bug.
function _cluster_member_names {
  docker compose exec -T "$(_node_host 1)" \
    evoke cluster member list < /dev/null 2> /dev/null \
    | jq --raw-output '.[].name' 2> /dev/null || true
}

# Whether one node is in the member list, which is a different question from
# whether it is running: enrolment is per node and can fail for one of them.
function _cluster_membership_state {
  local host
  local members="$2"

  host="$(_node_host "$1")"

  if grep --quiet --fixed-strings --line-regexp "$host" <<< "$members"; then
    echo 'enrolled'
  else
    echo 'missing'
  fi
}

# The tag the leader is actually running, which is what the spec asked for. This
# deliberately compares the requested tag rather than the appliance's
# self-reported build, so a symbolic tag like 5.0-stable verifies as cleanly as
# a pinned one -- and a stale container left over from an earlier version still
# shows up as a mismatch.
function _leader_image_tag {
  local container
  local image

  container="$(docker compose ps --quiet "$(_node_host 1)" 2> /dev/null || true)"
  if [[ -z "$container" ]]; then
    echo 'not running'
    return
  fi

  image="$(docker inspect --format '{{.Config.Image}}' "$container" 2> /dev/null || true)"
  if [[ -z "$image" ]]; then
    echo 'unknown'
    return
  fi

  echo "${image##*:}"
}

# Whether the leader's server keys are encrypted, read off the key files rather
# than off `bin/dap --enable-mke` having run. `evoke keys encrypt` replaces each
# `.key` with a `.key.enc`, and unlocking puts back only a symlink into /dev/shm,
# so symlinks are there either way and it is the regular files that answer:
# plaintext `.key` files mean unencrypted, `.key.enc` ones encrypted, and both at
# once a key that arrived after encryption. A dangling symlink (%Y of N) is an
# encrypted key nobody has unlocked since /dev/shm was last emptied.
#
# One find for the whole of /opt/conjur/etc, as `%y%Y path`: the keys live at up
# to three levels (ssl/external/<host>.key), and that is where evoke puts them.
function _leader_key_encryption_state {
  local listing
  local plaintext=false
  local encrypted=false
  local locked=false
  local kind
  local path

  listing="$(docker compose exec -T "$(_node_host 1)" \
    find /opt/conjur/etc -maxdepth 3 '(' -name '*.key' -o -name '*.key.enc' ')' -printf '%y%Y %p\n' \
    < /dev/null 2> /dev/null || true)"

  while read -r kind path; do
    case "$kind $path" in
      'ff '*.key.enc ) encrypted=true ;;
      'ff '*.key ) plaintext=true ;;
      'lN '*.key ) locked=true ;;
    esac
  done <<< "$listing"

  if [[ "$encrypted" == true && "$plaintext" == true ]]; then
    echo 'partly encrypted'
  elif [[ "$encrypted" == true && "$locked" == true ]]; then
    echo 'locked'
  elif [[ "$encrypted" == true ]]; then
    echo 'encrypted'
  elif [[ "$plaintext" == true ]]; then
    echo 'not encrypted'
  else
    echo 'unreadable'
  fi
}

# The CN out of one of s_client's `s:` or `i:` lines. Greedy, so it takes the
# last CN in the name, which is the one OpenSSL prints for the certificate itself.
function _common_name {
  sed -E 's/.*(:|, )CN = ([^,]*).*/\2/'
}

# The chain the leader load balancer hands a client, classified by who issued the
# leader's certificate: `appliance CA` for the self-signed CA `evoke configure
# master` creates, whose name carries `OU = Conjur CA`, and `custom CA` for the
# intermediate bin/generate-certs creates -- its CN read from the same file the
# generator issues it from, so the two cannot drift apart. The intermediate has
# to be in the chain as well as named as the issuer, because a client that trusts
# only the custom root cannot build a path without it.
#
# Asked from inside the leader, whose openssl is the appliance's own and whose
# name for the load balancer is the one clients use; the host's openssl might be
# LibreSSL, which prints the chain differently.
function _leader_certificate_state {
  local handshake
  local issuer
  local intermediate

  handshake="$(docker compose exec -T "$(_node_host 1)" \
    openssl s_client -connect conjur-master.mycompany.local:443 \
    -servername conjur-master.mycompany.local < /dev/null 2> /dev/null || true)"

  issuer="$(awk '/^ 0 s:/ { found = 1; next } found && /^   i:/ { print; exit }' <<< "$handshake")"
  if [[ -z "$issuer" ]]; then
    echo 'unreachable'
    return
  fi

  intermediate="$(jq --raw-output '.CN' artifacts/certificate-generator/configuration/intermediate_ca.json)"

  if [[ "$(_common_name <<< "$issuer")" == "$intermediate" ]]; then
    if grep '^ 1 s:' <<< "$handshake" | _common_name | grep --quiet --fixed-strings --line-regexp "$intermediate"; then
      echo 'custom CA'
    else
      echo 'no intermediate'
    fi
  elif [[ "$issuer" == *'OU = Conjur CA'* ]]; then
    echo 'appliance CA'
  else
    _common_name <<< "$issuer"
  fi
}

# Which DH parameters the leader's nginx serves: the pre-generated
# files/dhparam.pem bin/dap copies in, the RFC 3526 group `evoke configure master`
# installs as a stand-in and tags so that dhgen.sh knows to replace it, or ones the
# leader generated itself. The stand-in is the state worth naming -- a leader whose
# generation never finished is healthy and serving it.
function _leader_dh_params_state {
  local params

  params="$(docker compose exec -T "$(_node_host 1)" cat /etc/ssl/dhparam.pem < /dev/null 2> /dev/null || true)"

  if [[ -z "$params" ]]; then
    echo 'unreadable'
  elif [[ "$params" == *'BOOTSTRAP PARAMETERS'* ]]; then
    echo 'bootstrap'
  elif [[ "$params" == "$(cat files/dhparam.pem)" ]]; then
    echo 'pre-generated'
  elif [[ "$params" == *'-----BEGIN DH PARAMETERS-----'* ]]; then
    echo 'generated'
  else
    echo 'unrecognised'
  fi
}

# Whether one standby is actually receiving WAL from the leader, which is a
# different question from whether its container is up.
#
# The leader's /health carries a pg_stat_replication row per attached replica, and
# there is no `evoke replication status` to ask instead, so the leader's own view
# is the source. A standby that has stopped replicating is simply absent from that
# list rather than present and unhealthy, so absence is the case worth naming.
function _standby_replication_state {
  local host
  host="$(_node_host "$1")"

  # Keyed on usename, which is the replication role `evoke seed standby $host ...`
  # creates and so carries the standby's hostname exactly. Not application_name:
  # that is an opaque `standby_<hex>_<hex>` with no hostname in it at all, and
  # keying on it reports a healthy cluster as not replicating.
  _leader_probe 'health' "
    [ (.database.replication_status.pg_stat_replication // [])[]
      | select((.usename // \"\") == \"$host\") ]
    | if length == 0 then \"not replicating\" else (.[0].state // \"unknown\") end"
}

function _running_standbys {
  local count=0
  local number

  # The leader is conjur-master-1, so standbys start at 2.
  for number in 2 3 4 5; do
    if [[ -n "$(docker compose ps --quiet --status running "$(_node_host "$number")" 2> /dev/null)" ]]; then
      count=$((count + 1))
    fi
  done

  echo "$count"
}

function _running_followers {
  local count=0
  local number

  for ((number = 1; number <= FOLLOWER_CEILING; number++)); do
    if [[ -n "$(docker compose ps --quiet --status running "conjur-follower-$number.mycompany.local" 2> /dev/null)" ]]; then
      count=$((count + 1))
    fi
  done

  echo "$count"
}

# Whether the sample secret reads back through the bin/api invocation given. The
# value, not the exit status: a fetch against an appliance whose policy loaded but
# whose values never got set succeeds with an empty object, and reading the status
# alone would call that loaded.
function _sample_secret_reads_back {
  local secrets

  if ! secrets="$(bin/api "$@" --fetch-secrets 2> /dev/null)"; then
    return 1
  fi

  grep --quiet --fixed-strings "$SAMPLE_SECRET_VALUE" <<< "$secrets"
}

function _sample_data_state {
  if _sample_secret_reads_back --against-master; then
    echo 'loaded'
  else
    echo 'not retrievable'
  fi
}

# The same secret read through the follower tier instead of the leader. This is a
# claim the leader cannot make on the follower's behalf, and it is the one an
# application actually depends on -- a follower whose /health is ok and whose
# replication is current is still useless if nothing can authenticate against it.
#
# --leader-url, not --against-master, and the difference is the point: bin/api reads
# secrets from whatever it is given as the leader URL, so --against-master only moves
# where it authenticates. Written that way this check would pass against an
# environment with no follower in it at all.
function _follower_secret_state {
  if _sample_secret_reads_back --leader-url "$FOLLOWER_URL"; then
    echo 'retrievable'
  else
    echo 'not retrievable'
  fi
}

# Each follower's lbtot -- the number of times the load balancer has chosen it --
# off the stats page, one `name count` line per follower. Columns are found by name
# in the header rather than by position, which HAProxy does not promise to keep.
function _follower_backend_selections {
  local csv

  if ! csv="$(curl --silent --max-time 10 "$FOLLOWER_LB_STATS_URL")"; then
    return 1
  fi

  awk -F, '
    NR == 1 {
      sub(/^# /, "")
      for (i = 1; i <= NF; i++) column[$i] = i
      next
    }
    $column["pxname"] == "www-backend" && $column["svname"] !~ /^(FRONTEND|BACKEND)$/ {
      print $column["svname"], $column["lbtot"]
    }' <<< "$csv"
}

# How many followers the load balancer actually sends requests to. Every follower
# healthy on its own port says nothing about this: a backend the load balancer
# never marks up -- one whose certificate it cannot verify, say -- leaves the tier
# serving from fewer followers than it has, while every other follower row passes.
#
# So it asks the load balancer. Twice as many requests as there are followers go
# through it, and a follower counts if the load balancer chose it for any of them.
# Round-robin would reach each with half as many; the slack is for a health check
# or another client landing in between. The counts are cumulative, so it is the
# difference across the requests that is read, not the totals.
function _follower_backends_used {
  local before
  local after
  local request

  if ! before="$(_follower_backend_selections)"; then
    echo 'unreachable'
    return
  fi

  for (( request = 0; request < 2 * SPEC_FOLLOWERS; request++ )); do
    curl --insecure --silent --max-time 10 "$FOLLOWER_LB_HEALTH_URL" > /dev/null || true
  done

  if ! after="$(_follower_backend_selections)"; then
    echo 'unreachable'
    return
  fi

  awk '
    FNR == NR { before[$1] = $2; next }
    $2 > before[$1] + 0 { used++ }
    END { print used + 0 }' <(echo "$before") <(echo "$after")
}

VERIFY_ROWS=''
VERIFY_MISMATCHED=false

function _check {
  local dimension="$1"
  local desired="$2"
  local actual="$3"
  local result='ok'

  if [[ "$desired" != "$actual" ]]; then
    result='MISMATCH'
    VERIFY_MISMATCHED=true
  fi

  # 22 wide because `standby 4 replication` is the longest dimension, 16 because
  # `not retrievable` is the longest value either middle column holds; narrower
  # columns shift RESULT right and the table stops scanning cleanly.
  VERIFY_ROWS+="$(printf '  %-22s %-16s %-16s %s' "$dimension" "$desired" "$actual" "$result")"$'\n'
}

function _verify {
  local cluster_name
  local members
  local number

  VERIFY_ROWS=''
  VERIFY_MISMATCHED=false

  echo 'Verification'
  echo

  # One /info call serves both the probe row and the auto-failover row.
  cluster_name="$(_leader_cluster_name)"

  _check 'leader health' 'ok' "$(_leader_health)"
  _check 'leader /info' 'reported' "$(_leader_info_state "$cluster_name")"
  _check 'leader image tag' "$SPEC_VERSION" "$(_leader_image_tag)"

  # Each read off the leader itself -- its key files, the chain its load balancer
  # hands a client, the file nginx takes its DH parameters from -- rather than off
  # the bin/dap step having run, and each checked whichever way the spec set it.
  local encryption='not encrypted'
  local certificate='appliance CA'
  local dh_params='pre-generated'
  [[ "$SPEC_MASTER_KEY_ENCRYPTION" == true ]] && encryption='encrypted'
  [[ "$SPEC_CUSTOM_CERTIFICATES" == true ]] && certificate='custom CA'
  [[ "$SPEC_GENERATE_DH" == true ]] && dh_params='generated'

  _check 'master key encryption' "$encryption" "$(_leader_key_encryption_state)"
  _check 'leader certificate' "$certificate" "$(_leader_certificate_state)"
  _check 'dh parameters' "$dh_params" "$(_leader_dh_params_state)"

  _check 'standbys running' "$SPEC_STANDBYS" "$(_running_standbys)"

  # Per standby rather than in aggregate: a cluster where one node is up but no
  # longer replicating is exactly the state a count cannot see, and the node
  # number is what the operator needs to go and look at.
  for number in $(_standby_numbers); do
    _check "standby $number replication" 'streaming' "$(_standby_replication_state "$number")"
  done

  _check 'followers running' "$SPEC_FOLLOWERS" "$(_running_followers)"

  # Asked of the follower, and asked only when the spec wanted one: a follower left
  # running from an earlier environment is reported by the count row above, but there
  # is nothing for these rows to be desired against.
  #
  # Health and replication are separate rows because they fail separately, and the
  # pair is what tells the states apart. `evoke seed follower` snapshots the leader's
  # database, so a follower whose replication stopped right afterwards is up,
  # healthy, and serving data that is quietly out of date -- the health row alone
  # calls that environment good.
  #
  # Per follower, as per standby: one follower down or behind is the finding, and
  # the number is where to go and look.
  for number in $(_follower_numbers); do
    _check "follower $number health" 'ok' "$(_follower_health "$number")"
    _check "follower $number replication" 'replicating' "$(_follower_replication_state "$number")"
  done

  if (( SPEC_FOLLOWERS > 0 )); then
    # And the end-to-end read, which goes through the follower load balancer and is
    # the only row that authenticates. Conditional on the sample data because that
    # is the secret it looks for; with no sample data there is nothing to retrieve.
    if [[ "$SPEC_SAMPLE_DATA" == true ]]; then
      _check 'follower secret read' 'retrievable' "$(_follower_secret_state)"
    fi

    # Which is one read, and so one follower. This is the row that says the load
    # balancer spreads reads across all of them.
    _check 'follower backends used' "$SPEC_FOLLOWERS" "$(_follower_backends_used)"
  fi

  # Whether the leader is clustered at all, as the spec's own true/false: any name
  # other than the one bin/dap enrols is reported as itself rather than folded into
  # a pass.
  _check 'auto-failover' "$SPEC_AUTO_FAILOVER" "$(_auto_failover_state "$cluster_name")"

  # The name on its own row as well, because the membership rows below cannot say
  # it: etcd is asked which nodes are in the cluster it holds, not which cluster
  # that is. Stating the expected name is the difference between a table that
  # verifies it and one that leaves the reader to infer it from `true`.
  #
  # Membership itself is read from etcd rather than inferred from the leader
  # answering. A leader is healthy whether or not its standbys ever joined, and a
  # cluster that is a member short fails over to one fewer node than the spec
  # described.
  if [[ "$SPEC_AUTO_FAILOVER" == true ]]; then
    _check 'cluster name' "$CLUSTER_NAME" "$cluster_name"

    members="$(_cluster_member_names)"

    for number in 1 $(_standby_numbers); do
      _check "cluster member $number" 'enrolled' "$(_cluster_membership_state "$number" "$members")"
    done
  fi

  if [[ "$SPEC_SAMPLE_DATA" == true ]]; then
    _check 'sample data' 'loaded' "$(_sample_data_state)"
  fi

  printf '  %-22s %-16s %-16s %s\n' 'DIMENSION' 'DESIRED' 'ACTUAL' 'RESULT'
  printf '%s' "$VERIFY_ROWS"
  echo

  if [[ "$VERIFY_MISMATCHED" == true ]]; then
    echo 'bin/env: the environment does not match the spec.' >&2
    return 1
  fi

  echo 'The environment matches the spec.'
  echo "Conjur is available at: 'https://localhost:${CONJUR_MASTER_PORT}'"
}

#
## The build
#

# The three phases in the one order that is safe: everything is checked, then the
# environment is built, then it is compared against the spec. Its own function so
# that the ordering is a thing the tests can pin -- a preflight that refuses has
# to mean nothing was provisioned, and that is the whole point of having one.
function _build {
  echo
  _preflight
  _provision
  echo
  _verify
}

#
## Entrypoint
#

# Set before the source-only return below, because the planner and the preflight
# checks read them and test/env.bats reaches those by sourcing this file.
PLAN_ONLY=false
RECREATE=false
SPEC_ARGUMENT=''

# Verification and preflight can only be exercised in full against a running
# appliance, which the fast tests deliberately do not have. Sourcing this file
# gives test/env.bats the helpers above without the entrypoint below, so the
# refusal paths, the table and the exit-on-mismatch behaviour stay covered.
if [[ -n "${BIN_ENV_SOURCE_ONLY:-}" ]]; then
  return 0
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --plan ) PLAN_ONLY=true ; shift ;;
    --recreate ) RECREATE=true ; shift ;;
    -h | --help ) _print_help ;;
    -* ) echo "bin/env: $1 is not a valid option" >&2 ; exit 1 ;;
    * )
      if [[ -n "$SPEC_ARGUMENT" ]]; then
        echo "bin/env: only one spec may be given (got '$SPEC_ARGUMENT' and '$1')" >&2
        exit 1
      fi
      SPEC_ARGUMENT="$1" ; shift ;;
  esac
done

# Before the spec is read: which container runtime this is does not depend on
# what the spec asks for, and a plan podman could never carry out is worse than
# no plan at all.
_refuse_podman

if [[ -z "$SPEC_ARGUMENT" ]]; then
  echo 'bin/env: a spec file is required' >&2
  echo "Try 'bin/env --help', or start from environments/examples/single-node.yml." >&2
  exit 1
fi

if ! RESOLVED_SPEC="$(_resolve_spec "$(_spec_path "$SPEC_ARGUMENT")")"; then
  echo 'bin/env: the spec was not accepted, so nothing was provisioned.' >&2
  exit 1
fi

_read_spec "$RESOLVED_SPEC"
_print_plan "$SPEC_ARGUMENT"

if [[ "$PLAN_ONLY" == true ]]; then
  echo
  echo 'Nothing was provisioned (--plan).'
  exit 0
fi

_build
